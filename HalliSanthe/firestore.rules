// firestore.rules
// Deploy these rules to your Firebase Console → Firestore → Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: anyone can read; only authenticated artisans can write
    match /products/{productId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.artisanId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.artisanId == request.auth.uid;
    }

    // Messages: buyers can create; only the target artisan can read
    match /messages/{messageId} {
      allow create: if true; // Any buyer can send inquiry
      allow read, update: if request.auth != null
        && resource.data.artisanId == request.auth.uid;
    }
  }
}
